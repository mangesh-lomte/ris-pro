{
  "name": "ris-system",
  "version": "1.0.0",
  "private": true,
  "description": "Radiology Information System (RIS) - Enterprise Healthcare Workflow Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "test": "npm run test --workspace=server",
    "test:unit": "npm run test:unit --workspace=server",
    "test:api": "npm run test:api --workspace=server",
    "test:phase3": "npm run test:phase3 --workspace=server",
    "test:orthanc": "npm run test:orthanc --workspace=server",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "seed:demo-dicom": "tsx server/scripts/seed-demo-dicom.ts",
    "db:studio": "prisma studio",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "^0.0.84",
    "@playwright/test": "^1.65.0",
    "@prisma/client": "^5.14.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "eslint": "^10.14.0",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  }
}
