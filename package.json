{
  "name": "ris-system",
  "version": "1.0.0",
  "private": true,
  "description": "Radiology Information System (RIS) - Enterprise Healthcare Workflow Platform",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"blue,green\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client"
  },
  "devDependencies": {
    "@prisma/client": "^5.14.0",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.5",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0"
  }
}
