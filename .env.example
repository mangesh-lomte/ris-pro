# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME?schema=public"

# Authentication Security
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"

# CORS Allowed Origin (Frontend URL)
CORS_ORIGIN="http://localhost:5173"

# PACS Integration Configuration
PACS_ADAPTER=orthanc
ORTHANC_URL="http://localhost:8042"
ORTHANC_USERNAME="your_orthanc_username"
ORTHANC_PASSWORD="your_orthanc_password"
ORTHANC_TIMEOUT_MS=5000
OHIF_BASE_URL="http://localhost:3000"
