# ==============================================================================
# RadAxis RIS — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=production
APP_ENV=demo

# Database Configuration (PostgreSQL 16 isolated container on port 5434)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/radaxis_ris?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=radaxis_ris

# Authentication Security
JWT_SECRET="radaxis_enterprise_secure_jwt_secret_production_2026"
JWT_EXPIRES_IN="8h"

# CORS Configuration (In production, set to your domain: e.g. https://yourdomain.com)
CORS_ORIGIN="http://localhost:5173"

# Orthanc PACS Integration
PACS_ADAPTER=orthanc
ORTHANC_URL="http://localhost:8044"
ORTHANC_USERNAME="orthanc"
ORTHANC_PASSWORD="orthanc"
ORTHANC_DICOM_AET="RADAXIS"
ORTHANC_DICOM_PORT=4244
ORTHANC_TIMEOUT_MS=5000

# OHIF Medical Imaging Viewer
OHIF_BASE_URL="http://localhost:3002"
OHIF_VIEWER_URL="http://localhost:3002"
