  content         Json // Structured content: { clinicalIndication: string, comparison: string, findings: string, impression: string }
  version         Int                @default(1)
  lastAutosavedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

