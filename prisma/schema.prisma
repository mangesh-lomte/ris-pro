datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// DOMAIN ENUMS
// ==========================================

enum UserRole {
  ADMIN
  RECEPTION
  TECHNOLOGIST
  RADIOLOGIST
  ENGINEER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
  UNSPECIFIED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  ARRIVED
  CHECKED_IN
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum OrderStatus {
  CREATED
  SCHEDULED
  ARRIVED
  READY_FOR_TECH
  SAFETY_REVIEW
  SAFETY_CLEARED
  PREPARATION_IN_PROGRESS
  PREPARED
  READY_FOR_SCAN
  SCAN_IN_PROGRESS
  SCAN_INTERRUPTED
  SCAN_COMPLETED
  IMAGE_QA_PENDING
  IMAGE_ACCEPTED
  REPEAT_REQUIRED
  IMAGE_REJECTED
  PACS_READY
  PACS_HANDOFF_PENDING
  PACS_HANDOFF_COMPLETE
  PACS_HANDOFF_FAILED
  SCAN_CANCELLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ImageQualityStatus {
  PENDING
  ACCEPTED
  REPEAT_REQUIRED
  REJECTED
}

enum ImageQualityReason {
  PATIENT_MOTION
  POSITIONING
  COVERAGE_INCOMPLETE
  TECHNICAL_ARTIFACT
  PROTOCOL_DEVIATION
  OTHER
}

enum PacsHandoffStatus {
  READY
  PENDING
  COMPLETE
  FAILED
}

enum PacsHandoffOutcome {
  SUCCESS
  FAILURE
}

enum PacsStudyLinkStatus {
  LINKED
  UNLINKED
}

enum RadiologistAssignmentStatus {
  ASSIGNED
  RELEASED
}

enum ScanState {
  NOT_STARTED
  IN_PROGRESS
  INTERRUPTED
  COMPLETED
  CANCELLED
}

enum ScanLifecycleAction {
  STARTED
  INTERRUPTED
  RESUMED
  COMPLETED
  CANCELLED
}

enum ContrastRoute {
  IV
  ORAL
  OTHER
}

enum IncidentCategory {
  CONTRAST_REACTION
  EXTRAVASATION
  PATIENT_DISTRESS
  PATIENT_REQUEST
  EQUIPMENT_RELATED
  WORKFLOW_EVENT
  OTHER
}

enum IncidentWorkflowAction {
  SCAN_INTERRUPTED
  SCAN_STOPPED
  CLINICIAN_NOTIFIED
  PATIENT_MONITORED
  OTHER
}

enum SafetyStatus {
  NOT_STARTED
  IN_REVIEW
  CLEARED
  REQUIRES_REVIEW
  BLOCKED
}

enum PreparationStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum FastingStatus {
  NOT_REQUIRED
  CONFIRMED
  NOT_CONFIRMED
  UNKNOWN
}

enum ConsentStatus {
  NOT_REQUIRED
  CONFIRMED
  NOT_CONFIRMED
}

enum DocumentCategory {
  REFERRAL
  LAB_RESULT
  CONSENT
  PREVIOUS_REPORT
  OTHER
}

enum StudyStatus {
  PENDING
  ACQUIRING
  ACQUIRED
  SENT_TO_PACS
  READY_FOR_REPORTING
  REPORTED
}

enum PacsStatus {
  NOT_SENT
  SENDING
  SENT
  FAILED
}

enum ReportStatus {
  DRAFT
  PRELIMINARY
  FINAL
  ADDENDUM
}

enum Priority {
  ROUTINE
  URGENT
  STAT
}

enum ModalityType {
  CT
  MRI
  XRAY
  ULTRASOUND
  MAMMOGRAPHY
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  INSURANCE
  ONLINE
}

enum EquipmentStatus {
  AVAILABLE
  OPERATIONAL
  BUSY
  MAINTENANCE
  UNDER_PM
  OUT_OF_SERVICE
}

enum AuthorizationStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum PayerType {
  SELF_PAY
  INSURANCE
  CORPORATE
}

enum PeerReviewStatus {
  PENDING
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum CriticalFindingStatus {
  PENDING
  ACKNOWLEDGED
}

enum ReportAmendmentType {
  CORRECTION
  ADDENDUM
}

enum ReportDeliveryMethod {
  RECEPTION_HANDOVER
  PATIENT_PORTAL
  REFERRING_PHYSICIAN
  PRINT
}

enum NotificationChannel {
  SMS
  EMAIL
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
}

// ==========================================
// DOMAIN ENTITIES
// ==========================================

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reports                      Report[]
  auditLogs                    AuditLog[]
  createdOrders                ImagingOrder[]                @relation("OrderCreatedBy")
  createdAppointments          Appointment[]                 @relation("AppointmentCreatedBy")
  safetyScreenings             TechnologistSafetyScreening[] @relation("SafetyScreeningCompletedBy")
  completedPreparations        TechnologistPreparation[]     @relation("PreparationCompletedBy")
  confirmedProtocols           ImagingOrder[]                @relation("ProtocolConfirmedBy")
  startedScans                 ScanLifecycle[]               @relation("ScanStartedBy")
  interruptedScans             ScanLifecycle[]               @relation("ScanInterruptedBy")
  resumedScans                 ScanLifecycle[]               @relation("ScanResumedBy")
  completedScans               ScanLifecycle[]               @relation("ScanCompletedBy")
  cancelledScans               ScanLifecycle[]               @relation("ScanCancelledBy")
  scanLifecycleEvents          ScanLifecycleEvent[]          @relation("ScanEventUser")
  administeredContrasts        ContrastAdministration[]      @relation("ContrastAdministeredBy")
  recordedIncidents            TechnologistIncident[]        @relation("IncidentRecordedBy")
  startedImageQAs              ImageQualityReview[]          @relation("QAStartedBy")
  reviewedImageQAs             ImageQualityReview[]          @relation("QAReviewedBy")
  repeatAuthorizedQAs          ImageQualityReview[]          @relation("QARepeatAuthorizedBy")
  initiatedPacsHandoffs        PacsHandoff[]                 @relation("PacsInitiatedBy")
  pacsHandoffAttempts          PacsHandoffAttempt[]          @relation("PacsAttemptInitiatedBy")
  verifiedStudyLinks           PacsStudyLink[]               @relation("StudyLinkVerifiedBy")
  radiologistAssignments       RadiologistAssignment[]       @relation("RadiologistAssignedUser")
  assignmentsCreated           RadiologistAssignment[]       @relation("RadiologistAssignedBy")
  assignmentsReleased          RadiologistAssignment[]       @relation("RadiologistReleasedBy")
  authoredDrafts               ReportDraft[]                 @relation("ReportDraftAuthor")
  peerReviewsRequested         PeerReviewRequest[]           @relation("PeerReviewRequester")
  peerReviewsAssigned          PeerReviewRequest[]           @relation("PeerReviewReviewer")
  criticalFindingsCreated      CriticalFinding[]             @relation("CriticalFindingCreatedBy")
  criticalFindingsReceived     CriticalFinding[]             @relation("CriticalFindingRecipient")
  criticalFindingsAcknowledged CriticalFinding[]             @relation("CriticalFindingAcknowledgedBy")
  reportAmendmentsCreated      ReportAmendment[]             @relation("ReportAmendmentCreatedBy")
  signedReports                Report[]                      @relation("ReportSignedBy")
  reportsReadied               Report[]                      @relation("ReportReadyBy")
  reportDeliveriesRecorded     ReportDelivery[]              @relation("DeliveryRecordedBy")
  reportNotificationsSent      ReportNotification[]          @relation("NotificationSentBy")
  reportReprintsRecorded       ReportReprint[]               @relation("ReportPrintedBy")
  externalShares               ExternalShare[]               @relation("ExternalShareCreatedBy")
  transfers                    LargeFileTransfer[]           @relation("TransferCreatedBy")
  outsideImportsCreated        OutsideStudyImport[]          @relation("OutsideImportCreatedBy")
  outsideImportsReconciled     OutsideStudyImport[]          @relation("ImportReconciledBy")
  uploadedDocuments            OrderDocument[]               @relation("DocumentUploadedBy")

  @@map("users")
}

model Patient {
  id                       String   @id @default(cuid())
  patientId                String   @unique // Master Patient Index / Persistent Medical Record Number (PAT-YYYY-XXXXX)
  firstName                String
  middleName               String?
  lastName                 String
  dateOfBirth              DateTime
  gender                   Gender
  phone                    String
  alternatePhone           String?
  email                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  address                  String? // Legacy backward-compatibility representation
  emergencyContact         String? // Legacy backward-compatibility representation
  isActive                 Boolean  @default(true)
  isMerged                 Boolean  @default(false)
  mergedIntoId             String?
  mergedInto               Patient? @relation("PatientMergeHistory", fields: [mergedIntoId], references: [id])
  mergedPatients           Patient[] @relation("PatientMergeHistory")
  mergedAt                 DateTime?
  mergedById               String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  appointments        Appointment[]
  imagingOrders       ImagingOrder[]
  studies             Study[]
  invoices            Invoice[]
  quotations          Quotation[]
  safetyScreenings    TechnologistSafetyScreening[]
  preparations        TechnologistPreparation[]
  externalShares      ExternalShare[]
  shareConsents       ShareConsent[]
  outsideStudyImports OutsideStudyImport[]
  orderDocuments      OrderDocument[]

  @@index([lastName, firstName])
  @@index([phone])
  @@index([patientId])
  @@index([dateOfBirth])
  @@index([isMerged])
  @@map("patients")
}

model ReferringDoctor {
  id                 String   @id @default(cuid())
  name               String
  organization       String?
  phone              String?
  email              String?
  registrationNumber String? // Generic national/state medical board registration identifier
  providerIdentifier String? // Generic provider / institution identifier
  npi                String? // Optional legacy/US-specific NPI field (optional only)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  imagingOrders ImagingOrder[]

  @@index([name])
  @@map("referring_doctors")
}

model ExamDefinition {
  id                                String       @id @default(cuid())
  code                              String       @unique // e.g. "CT-HEAD", "MRI-BRAIN"
  name                              String // e.g. "CT Head / Brain without Contrast"
  modality                          ModalityType
  bodyPart                          String
  defaultDurationMinutes            Int          @default(30)
  bufferMinutes                     Int          @default(5)
  contrastSupported                 Boolean      @default(false)
  fastingRequired                   Boolean      @default(false)
  ivRequired                        Boolean      @default(false)
  consentRequired                   Boolean      @default(false)
  contrastPreparationRequired       Boolean      @default(false)
  additionalPreparationInstructions String?
  isActive                          Boolean      @default(true)
  createdAt                         DateTime     @default(now())
  updatedAt                         DateTime     @updatedAt

  appointments Appointment[]
  protocols    ImagingProtocol[]

  @@index([modality])
  @@index([code])
  @@map("exam_definitions")
}

model Equipment {
  id                  String          @id @default(cuid())
  assetTag            String?         @unique // e.g. "EQ-CT-001", "EQ-MRI-001", "EQ-CHILLER-001", "EQ-UPS-001"
  name                String // e.g. "GE Revolution CT 128-Slice"
  modality            ModalityType
  assetCategory       String          @default("SCANNER") // "SCANNER", "INJECTOR", "CHILLER", "UPS", "ANCILLARY"
  manufacturer        String // e.g. "GE Healthcare"
  model               String // e.g. "Revolution EVO"
  serialNumber        String          @unique
  status              EquipmentStatus @default(AVAILABLE)
  location            String // e.g. "Room CT-01, Ground Floor"
  roomNumber          String?
  department          String?         @default("Radiology")
  installationDate    DateTime?
  warrantyExpiryDate  DateTime?
  powerRatingKva      Decimal?        @db.Decimal(8, 2)
  operatingTempMin    Decimal?        @db.Decimal(5, 2)
  operatingTempMax    Decimal?        @db.Decimal(5, 2)
  notes               String?         @db.Text
  active              Boolean         @default(true)
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  appointments   Appointment[]
  scanLifecycles ScanLifecycle[]
  pmSchedules    MaintenanceSchedule[]
  qcChecks       EquipmentQcCheck[]
  serviceTickets ServiceTicket[]
  downtimes      EquipmentDowntime[]
  partsUsages    MaintenancePartUsage[]
  serviceRecords ServiceRecord[]
  certificates   CalibrationCertificate[]
  contracts      MaintenanceContract[]

  @@index([modality])
  @@index([status])
  @@index([assetCategory])
  @@map("equipment")
}

model ImagingOrder {
  id                    String              @id @default(cuid())
  accessionNumber       String              @unique // Unique Accession Number: single source of truth across all workflows
  patientId             String
  patient               Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  modality              ModalityType
  bodyPart              String // e.g. "Chest", "Brain", "Abdomen", "Right Knee"
  examinationName       String // e.g. "MRI Brain without Contrast"
  clinicalIndication    String              @db.Text
  referringDoctorId     String?
  referringDoctor       ReferringDoctor?    @relation(fields: [referringDoctorId], references: [id], onDelete: SetNull)
  referringDoctorText   String? // Free-text fallback if doctor is external or unregistered
  contrastRequired      Boolean             @default(false)
  priority              Priority            @default(ROUTINE)
  orderStatus           OrderStatus         @default(CREATED)
  authorizationStatus   AuthorizationStatus @default(NOT_REQUIRED)
  payerType             PayerType?          @default(SELF_PAY)
  payerName             String?
  memberId              String?
  authorizationRequired Boolean             @default(false)
  authorizationCode     String?
  insuranceNotes        String?             @db.Text
  createdById           String?
  createdBy             User?               @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  appointment             Appointment?
  study                   Study?
  report                  Report?
  invoice                 Invoice?
  safetyScreening         TechnologistSafetyScreening?
  preparation             TechnologistPreparation?
  confirmedProtocolId     String?
  confirmedProtocol       ImagingProtocol?             @relation(fields: [confirmedProtocolId], references: [id], onDelete: SetNull)
  protocolConfirmedAt     DateTime?
  protocolConfirmedById   String?
  protocolConfirmedBy     User?                        @relation("ProtocolConfirmedBy", fields: [protocolConfirmedById], references: [id], onDelete: SetNull)
  scanLifecycles          ScanLifecycle[]
  contrastAdministrations ContrastAdministration[]
  incidents               TechnologistIncident[]
  imageQualityReviews     ImageQualityReview[]
  pacsHandoffs            PacsHandoff[]
  pacsStudyLink           PacsStudyLink?
  radiologistAssignments  RadiologistAssignment[]
  reportDraft             ReportDraft?
  peerReviewRequests      PeerReviewRequest[]
  criticalFindings        CriticalFinding[]
  externalShares          ExternalShare[]
  transfers               LargeFileTransfer[]
  outsideStudyImports     OutsideStudyImport[]
  documents               OrderDocument[]

  @@index([patientId])
  @@index([accessionNumber])
  @@index([orderStatus])
  @@index([modality])
  @@index([confirmedProtocolId])
  @@index([createdAt])
  @@map("imaging_orders")
}

model Appointment {
  id                 String            @id @default(cuid())
  appointmentNumber  String            @unique // e.g. APT-2026-0001
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  imagingOrderId     String?           @unique
  imagingOrder       ImagingOrder?     @relation(fields: [imagingOrderId], references: [id], onDelete: SetNull)
  modality           ModalityType
  equipmentId        String?
  equipment          Equipment?        @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  examDefinitionId   String?
  examDefinition     ExamDefinition?   @relation(fields: [examDefinitionId], references: [id], onDelete: SetNull)
  examination        String // Descriptive examination name
  scheduledStart     DateTime
  scheduledEnd       DateTime
  durationMinutes    Int               @default(30)
  status             AppointmentStatus @default(SCHEDULED)
  priority           Priority          @default(ROUTINE)
  location           String? // e.g. "Scanner Suite 2 - CT"
  notes              String?           @db.Text
  cancellationReason String?           @db.Text
  noShowReason       String?           @db.Text
  rescheduleReason   String?           @db.Text
  tokenNumber        String? // Daily queue token e.g. "MRI-001" or "A001"
  checkedInAt        DateTime?
  checkedInById      String?
  cancelledAt        DateTime?
  createdById        String?
  createdBy          User?             @relation("AppointmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  safetyScreening TechnologistSafetyScreening?
  preparation     TechnologistPreparation?

  @@index([patientId])
  @@index([imagingOrderId])
  @@index([equipmentId])
  @@index([scheduledStart, scheduledEnd])
  @@index([status])
  @@index([createdAt])
  @@map("appointments")
}

model TechnologistSafetyScreening {
  id                         String       @id @default(cuid())
  imagingOrderId             String       @unique
  imagingOrder               ImagingOrder @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  patientId                  String
  patient                    Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId              String?      @unique
  appointment                Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  completedByUserId          String
  completedByUser            User         @relation("SafetyScreeningCompletedBy", fields: [completedByUserId], references: [id])
  modality                   ModalityType
  identityVerified           Boolean      @default(false)
  identityVerificationMethod String?
  identityVerifiedAt         DateTime?
  safetyStatus               SafetyStatus @default(NOT_STARTED)
  safetyNotes                String?      @db.Text
  answers                    Json
  riskFactors                String[]     @default([])
  reviewedAt                 DateTime?
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  @@index([imagingOrderId])
  @@index([patientId])
  @@index([safetyStatus])
  @@map("technologist_safety_screenings")
}

model TechnologistPreparation {
  id                                String            @id @default(cuid())
  imagingOrderId                    String            @unique
  imagingOrder                      ImagingOrder      @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  patientId                         String
  patient                           Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId                     String?           @unique
  appointment                       Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  completedByUserId                 String?
  completedByUser                   User?             @relation("PreparationCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  fastingRequired                   Boolean           @default(false)
  fastingStatus                     FastingStatus     @default(NOT_REQUIRED)
  ivRequired                        Boolean           @default(false)
  ivReady                           Boolean           @default(false)
  contrastPreparationRequired       Boolean           @default(false)
  contrastReady                     Boolean           @default(false)
  consentRequired                   Boolean           @default(false)
  consentStatus                     ConsentStatus     @default(NOT_REQUIRED)
  additionalPreparationRequired     Boolean           @default(false)
  additionalPreparationComplete     Boolean           @default(false)
  additionalPreparationInstructions String?
  preparationNotes                  String?           @db.Text
  preparationStatus                 PreparationStatus @default(NOT_STARTED)
  preparedAt                        DateTime?
  createdAt                         DateTime          @default(now())
  updatedAt                         DateTime          @updatedAt

  @@index([imagingOrderId])
  @@index([patientId])
  @@index([preparationStatus])
  @@map("technologist_preparations")
}

model ImagingProtocol {
  id               String          @id @default(cuid())
  code             String          @unique // e.g. "MRI-BRAIN-ROUTINE", "CT-HEAD-NONCONTRAST"
  name             String // e.g. "MRI Brain Routine Diagnostic"
  modality         ModalityType
  examDefinitionId String?
  examDefinition   ExamDefinition? @relation(fields: [examDefinitionId], references: [id], onDelete: SetNull)
  bodyPart         String?
  description      String?         @db.Text
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  confirmedOrders ImagingOrder[]

  @@index([modality])
  @@index([code])
  @@index([isActive])
  @@map("imaging_protocols")
}

model ScanLifecycle {
  id                  String       @id @default(cuid())
  imagingOrderId      String
  imagingOrder        ImagingOrder @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  attemptNumber       Int          @default(1)
  equipmentId         String?
  equipment           Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  startedByUserId     String?
  startedByUser       User?        @relation("ScanStartedBy", fields: [startedByUserId], references: [id], onDelete: SetNull)
  startedAt           DateTime     @default(now())
  interruptedByUserId String?
  interruptedByUser   User?        @relation("ScanInterruptedBy", fields: [interruptedByUserId], references: [id], onDelete: SetNull)
  interruptedAt       DateTime?
  interruptionReason  String?
  interruptionNotes   String?      @db.Text
  resumedByUserId     String?
  resumedByUser       User?        @relation("ScanResumedBy", fields: [resumedByUserId], references: [id], onDelete: SetNull)
  resumedAt           DateTime?
  completedByUserId   String?
  completedByUser     User?        @relation("ScanCompletedBy", fields: [completedByUserId], references: [id], onDelete: SetNull)
  completedAt         DateTime?
  cancelledByUserId   String?
  cancelledByUser     User?        @relation("ScanCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  cancelledAt         DateTime?
  cancellationReason  String?
  cancellationNotes   String?      @db.Text
  state               ScanState    @default(IN_PROGRESS)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  events                  ScanLifecycleEvent[]
  contrastAdministrations ContrastAdministration[]
  incidents               TechnologistIncident[]
  imageQualityReview      ImageQualityReview?
  pacsHandoff             PacsHandoff?

  @@unique([imagingOrderId, attemptNumber])
  @@index([imagingOrderId])
  @@index([equipmentId])
  @@index([state])
  @@map("scan_lifecycles")
}

model ScanLifecycleEvent {
  id              String              @id @default(cuid())
  scanLifecycleId String
  scanLifecycle   ScanLifecycle       @relation(fields: [scanLifecycleId], references: [id], onDelete: Cascade)
  action          ScanLifecycleAction
  userId          String?
  user            User?               @relation("ScanEventUser", fields: [userId], references: [id], onDelete: SetNull)
  timestamp       DateTime            @default(now())
  reason          String?
  notes           String?             @db.Text
  metadata        Json?

  @@index([scanLifecycleId])
  @@index([action])
  @@index([timestamp])
  @@map("scan_lifecycle_events")
}

model ContrastAdministration {
  id                   String         @id @default(cuid())
  imagingOrderId       String
  imagingOrder         ImagingOrder   @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  scanLifecycleId      String?
  scanLifecycle        ScanLifecycle? @relation(fields: [scanLifecycleId], references: [id], onDelete: SetNull)
  contrastAgentName    String
  concentration        String?
  volume               Decimal        @db.Decimal(8, 2)
  volumeUnit           String         @default("mL")
  route                ContrastRoute  @default(IV)
  routeNotes           String?
  batchLotNumber       String?
  expirationDate       DateTime?
  administeredAt       DateTime       @default(now())
  administeredByUserId String
  administeredByUser   User           @relation("ContrastAdministeredBy", fields: [administeredByUserId], references: [id])
  administrationNotes  String?        @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  incidents TechnologistIncident[]

  @@index([imagingOrderId])
  @@index([scanLifecycleId])
  @@index([administeredByUserId])
  @@index([administeredAt])
  @@map("contrast_administrations")
}

model TechnologistIncident {
  id                       String                  @id @default(cuid())
  imagingOrderId           String
  imagingOrder             ImagingOrder            @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  scanLifecycleId          String?
  scanLifecycle            ScanLifecycle?          @relation(fields: [scanLifecycleId], references: [id], onDelete: SetNull)
  contrastAdministrationId String?
  contrastAdministration   ContrastAdministration? @relation(fields: [contrastAdministrationId], references: [id], onDelete: SetNull)
  category                 IncidentCategory
  description              String                  @db.Text
  occurredAt               DateTime                @default(now())
  recordedAt               DateTime                @default(now())
  recordedByUserId         String
  recordedByUser           User                    @relation("IncidentRecordedBy", fields: [recordedByUserId], references: [id])
  clinicianNotified        Boolean                 @default(false)
  clinicianNotifiedAt      DateTime?
  notificationNotes        String?                 @db.Text
  workflowActionTaken      IncidentWorkflowAction?
  workflowActionNotes      String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  @@index([imagingOrderId])
  @@index([scanLifecycleId])
  @@index([contrastAdministrationId])
  @@index([recordedByUserId])
  @@index([category])
  @@index([recordedAt])
  @@map("technologist_incidents")
}

model ImageQualityReview {
  id                       String              @id @default(cuid())
  imagingOrderId           String
  imagingOrder             ImagingOrder        @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  scanLifecycleId          String              @unique
  scanLifecycle            ScanLifecycle       @relation(fields: [scanLifecycleId], references: [id], onDelete: Cascade)
  status                   ImageQualityStatus  @default(PENDING)
  startedByUserId          String
  startedByUser            User                @relation("QAStartedBy", fields: [startedByUserId], references: [id])
  startedAt                DateTime            @default(now())
  reviewedByUserId         String?
  reviewedByUser           User?               @relation("QAReviewedBy", fields: [reviewedByUserId], references: [id])
  reviewedAt               DateTime?
  reasonCode               ImageQualityReason?
  notes                    String?             @db.Text
  repeatAuthorizedByUserId String?
  repeatAuthorizedByUser   User?               @relation("QARepeatAuthorizedBy", fields: [repeatAuthorizedByUserId], references: [id])
  repeatAuthorizedAt       DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  pacsHandoff PacsHandoff?

  @@index([imagingOrderId])
  @@index([scanLifecycleId])
  @@index([status])
  @@index([startedAt])
  @@map("image_quality_reviews")
}

model PacsHandoff {
  id                   String             @id @default(cuid())
  imagingOrderId       String
  imagingOrder         ImagingOrder       @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  scanLifecycleId      String             @unique
  scanLifecycle        ScanLifecycle      @relation(fields: [scanLifecycleId], references: [id], onDelete: Cascade)
  imageQualityReviewId String             @unique
  imageQualityReview   ImageQualityReview @relation(fields: [imageQualityReviewId], references: [id], onDelete: Cascade)
  status               PacsHandoffStatus  @default(READY)
  attemptCount         Int                @default(0)
  initiatedByUserId    String?
  initiatedByUser      User?              @relation("PacsInitiatedBy", fields: [initiatedByUserId], references: [id])
  initiatedAt          DateTime?
  lastAttemptAt        DateTime?
  completedAt          DateTime?
  lastErrorCode        String?
  lastErrorMessage     String?            @db.Text
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  attempts PacsHandoffAttempt[]

  @@index([imagingOrderId])
  @@index([scanLifecycleId])
  @@index([imageQualityReviewId])
  @@index([status])
  @@map("pacs_handoffs")
}

model PacsHandoffAttempt {
  id                String             @id @default(cuid())
  pacsHandoffId     String
  pacsHandoff       PacsHandoff        @relation(fields: [pacsHandoffId], references: [id], onDelete: Cascade)
  attemptNumber     Int
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  outcome           PacsHandoffOutcome
  errorCode         String?
  errorMessage      String?            @db.Text
  initiatedByUserId String
  initiatedByUser   User               @relation("PacsAttemptInitiatedBy", fields: [initiatedByUserId], references: [id])
  createdAt         DateTime           @default(now())

  @@unique([pacsHandoffId, attemptNumber])
  @@index([pacsHandoffId])
  @@index([outcome])
  @@map("pacs_handoff_attempts")
}

model PacsStudyLink {
  id               String              @id @default(cuid())
  imagingOrderId   String              @unique
  imagingOrder     ImagingOrder        @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  orthancStudyId   String              @unique
  studyInstanceUid String?             @unique
  status           PacsStudyLinkStatus @default(LINKED)
  verifiedAt       DateTime            @default(now())
  verifiedByUserId String
  verifiedByUser   User                @relation("StudyLinkVerifiedBy", fields: [verifiedByUserId], references: [id])
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([orthancStudyId])
  @@index([imagingOrderId])
  @@map("pacs_study_links")
}

model RadiologistAssignment {
  id                String                      @id @default(cuid())
  imagingOrderId    String
  imagingOrder      ImagingOrder                @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  radiologistUserId String
  radiologistUser   User                        @relation("RadiologistAssignedUser", fields: [radiologistUserId], references: [id])
  assignedByUserId  String
  assignedByUser    User                        @relation("RadiologistAssignedBy", fields: [assignedByUserId], references: [id])
  assignedAt        DateTime                    @default(now())
  releasedAt        DateTime?
  releasedByUserId  String?
  releasedByUser    User?                       @relation("RadiologistReleasedBy", fields: [releasedByUserId], references: [id])
  status            RadiologistAssignmentStatus @default(ASSIGNED)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([imagingOrderId])
  @@index([radiologistUserId])
  @@index([status])
  @@map("radiologist_assignments")
}

model Study {
  id               String       @id @default(cuid())
  studyInstanceUid String?      @unique // Conceptual DICOM Study Instance UID for future PACS integration
  accessionNumber  String // Matched with order accession number
  orderId          String       @unique
  order            ImagingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  modality         ModalityType
  studyStatus      StudyStatus  @default(PENDING)
  pacsStatus       PacsStatus   @default(NOT_SENT)
  seriesCount      Int          @default(0)
  instanceCount    Int          @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  report Report?

  @@index([patientId])
  @@index([accessionNumber])
  @@map("studies")
}

model Report {
  id                    String       @id @default(cuid())
  studyId               String       @unique
  study                 Study        @relation(fields: [studyId], references: [id], onDelete: Cascade)
  orderId               String       @unique
  order                 ImagingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  radiologistId         String?
  radiologist           User?        @relation(fields: [radiologistId], references: [id], onDelete: SetNull)
  status                ReportStatus @default(DRAFT)
  draftContent          String?      @db.Text
  findings              String?      @db.Text
  impression            String?      @db.Text
  finalizedAt           DateTime?
  version               Int          @default(1)
  signedAt              DateTime?
  signedById            String?
  signedBy              User?        @relation("ReportSignedBy", fields: [signedById], references: [id], onDelete: SetNull)
  isSigned              Boolean      @default(false)
  isLocked              Boolean      @default(false)
  digitalSignature      Json?
  signatureHash         String?
  pdfGeneratedAt        DateTime?
  pdfArtifactPath       String?
  pdfFileSizeBytes      Int?
  pdfVersion            Int?
  isReadyForReception   Boolean      @default(false)
  readyForReceptionAt   DateTime?
  readyForReceptionById String?
  readyForReceptionBy   User?        @relation("ReportReadyBy", fields: [readyForReceptionById], references: [id], onDelete: SetNull)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  amendments     ReportAmendment[]
  deliveries     ReportDelivery[]
  notifications  ReportNotification[]
  reprints       ReportReprint[]
  externalShares ExternalShare[]

  @@index([radiologistId])
  @@index([signedById])
  @@index([readyForReceptionById])
  @@index([isReadyForReception])
  @@index([status])
  @@map("reports")
}

model Invoice {
  id                   String        @id @default(cuid())
  invoiceNumber        String        @unique // e.g. INV-2026-0001
  patientId            String
  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderId              String?       @unique
  order                ImagingOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  grossAmount          Decimal       @default(0.00) @db.Decimal(10, 2)
  discount             Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount            Decimal       @default(0.00) @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2) // Net payable = grossAmount - discount + taxAmount
  paidAmount           Decimal       @default(0.00) @db.Decimal(10, 2)
  outstandingAmount    Decimal       @db.Decimal(10, 2)
  status               InvoiceStatus @default(PENDING)
  discountReason       String?
  discountApprovedById String?
  discountApprovedAt   DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  payments Payment[]
  items    InvoiceItem[]
  receipts Receipt[]
  refunds  Refund[]
  claims   InsuranceClaim[]

  @@index([patientId])
  @@map("invoices")
}

model Payment {
  id             String        @id @default(cuid())
  invoiceId      String
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount         Decimal       @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH)
  reference      String? // Transaction ID, Cheque number, Auth code
  paymentStatus  PaymentStatus @default(COMPLETED)
  paidAt         DateTime      @default(now())
  recordedById   String?
  idempotencyKey String?       @unique
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  receipt Receipt?
  refunds Refund[]

  @@index([invoiceId])
  @@map("payments")
}

model PriceMasterItem {
  id        String        @id @default(cuid())
  code      String        @unique // e.g. "SRV-CT-HEAD", "SRV-MRI-BRAIN", "SRV-CONTRAST-IV", "SRV-FILM-14X17"
  name      String
  modality  ModalityType?
  category  String // "EXAMINATION", "CONTRAST", "FILM", "PACKAGE", "SERVICE"
  basePrice Decimal       @db.Decimal(10, 2)
  taxRate   Decimal       @default(0.00) @db.Decimal(5, 2)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([category])
  @@index([modality])
  @@map("price_master_items")
}

model Quotation {
  id              String   @id @default(cuid())
  quotationNumber String   @unique // e.g. "QTE-2026-0001"
  patientId       String
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  orderId         String?
  grossAmount     Decimal  @db.Decimal(10, 2)
  discount        Decimal  @default(0.00) @db.Decimal(10, 2)
  discountReason  String?
  taxAmount       Decimal  @default(0.00) @db.Decimal(10, 2)
  netAmount       Decimal  @db.Decimal(10, 2)
  status          String   @default("ISSUED") // "ISSUED", "ACCEPTED", "EXPIRED", "CONVERTED"
  validUntil      DateTime
  notes           String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items QuotationItem[]

  @@index([patientId])
  @@index([orderId])
  @@map("quotations")
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  serviceCode String
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  totalPrice  Decimal   @db.Decimal(10, 2)

  @@index([quotationId])
  @@map("quotation_items")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceCode String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  itemType    String  @default("EXAM") // "EXAM", "CONTRAST", "FILM", "PROCEDURE", "PACKAGE"

  @@index([invoiceId])
  @@map("invoice_items")
}

model Receipt {
  id            String        @id @default(cuid())
  receiptNumber String        @unique // e.g. RCP-2026-0001
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId     String        @unique
  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  patientId     String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  reference     String?
  issuedById    String?
  issuedAt      DateTime      @default(now())
  receiptData   Json?

  @@index([invoiceId])
  @@index([patientId])
  @@map("receipts")
}

model Refund {
  id            String        @id @default(cuid())
  refundNumber  String        @unique // e.g. REF-2026-0001
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId     String?
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  amount        Decimal       @db.Decimal(10, 2)
  reason        String
  refundMethod  PaymentMethod @default(CASH)
  reference     String?
  processedById String
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([paymentId])
  @@map("refunds")
}

model InsuranceClaim {
  id                  String    @id @default(cuid())
  claimNumber         String    @unique // e.g. CLM-2026-0001
  invoiceId           String?
  invoice             Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  orderId             String?
  patientId           String
  payerName           String
  policyNumber        String
  preAuthCode         String?
  claimAmount         Decimal   @db.Decimal(10, 2)
  approvedAmount      Decimal   @default(0.00) @db.Decimal(10, 2)
  copayAmount         Decimal   @default(0.00) @db.Decimal(10, 2)
  status              String    @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED, SETTLED
  settlementReference String?
  settledAt           DateTime?
  documents           Json?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([invoiceId])
  @@index([patientId])
  @@index([orderId])
  @@map("insurance_claims")
}

model CashierClosing {
  id              String   @id @default(cuid())
  closingNumber   String   @unique // e.g. CLS-2026-0001
  cashierId       String
  cashierName     String
  closingDate     DateTime @default(now())
  openingFloat    Decimal  @default(0.00) @db.Decimal(10, 2)
  cashCollected   Decimal  @default(0.00) @db.Decimal(10, 2)
  cardCollected   Decimal  @default(0.00) @db.Decimal(10, 2)
  upiCollected    Decimal  @default(0.00) @db.Decimal(10, 2)
  onlineCollected Decimal  @default(0.00) @db.Decimal(10, 2)
  refundsTotal    Decimal  @default(0.00) @db.Decimal(10, 2)
  expectedCash    Decimal  @db.Decimal(10, 2)
  actualCash      Decimal  @db.Decimal(10, 2)
  variance        Decimal  @db.Decimal(10, 2)
  notes           String?
  status          String   @default("CLOSED")
  closedAt        DateTime @default(now())

  @@index([cashierId])
  @@index([closingDate])
  @@map("cashier_closings")
}

model InventoryItem {
  id             String    @id @default(cuid())
  itemCode       String    @unique // e.g. "INV-CONTRAST-OMNI350", "ITEM-CON-001"
  name           String // e.g. "Omnipaque 350 mg I/mL (100 mL)"
  category       String // "CONTRAST", "MEDICINE", "FILM", "CONSUMABLE", "EMERGENCY_KIT"
  subCategory    String? // "IODINATED", "GADOLINIUM", "XRAY_FILM", "SYRINGE", "IV_CANNULA", "TUBING"
  unit           String    @default("PIECE") // "VIAL", "BOX", "SHEET", "PIECE", "ML", "PACK"
  barcode        String?   @unique // for Barcode / QR scanner resolution
  sku            String? // legacy/alias SKU
  quantity       Int       @default(0) // total available stock cached/aggregate
  reorderLevel   Int       @default(10)
  unitPrice      Decimal   @default(0.00) @db.Decimal(10, 2)
  contrastType   String? // "IODINATED", "GADOLINIUM"
  concentration  String? // "350 mg/mL", "1.0 mmol/mL"
  packSize       String? // "100 mL", "15 mL", "14x17 inch"
  filmSize       String? // "8x10", "10x12", "14x17"
  isEmergencyKit Boolean   @default(false)
  active         Boolean   @default(true)
  batchNumber    String? // legacy field
  lotNumber      String? // legacy field
  expiryDate     DateTime? // legacy field
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  batches                 InventoryBatch[]
  locationStocks          LocationStock[]
  transactions            StockTransaction[]
  wastageLogs             WastageLog[]
  orderUsages             OrderConsumableUsage[]
  auditItems              StockAuditItem[]
  emergencyChecklistItems EmergencyChecklistItem[]
  maintenanceUsages       MaintenancePartUsage[]

  @@index([category])
  @@index([contrastType])
  @@map("inventory_items")
}

model InventoryBatch {
  id              String        @id @default(cuid())
  batchNumber     String // e.g. "LOT-2026-001"
  itemId          String
  item            InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierName    String? // e.g. "GE Healthcare", "Bayer Pharma", "Carestream"
  purchaseInvoice String? // e.g. "PI-2026-9901"
  expiryDate      DateTime // Expiry date for alerts & FEFO
  receivedDate    DateTime      @default(now())
  initialQuantity Int
  currentQuantity Int           @default(0)
  unitCost        Decimal       @default(0.00) @db.Decimal(10, 2)
  isBlocked       Boolean       @default(false) // e.g. recalled or quarantined
  blockReason     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  locationStocks    LocationStock[]
  transactions      StockTransaction[]
  wastageLogs       WastageLog[]
  orderUsages       OrderConsumableUsage[]
  auditItems        StockAuditItem[]
  maintenanceUsages MaintenancePartUsage[]

  @@unique([itemId, batchNumber])
  @@index([itemId])
  @@index([expiryDate])
  @@map("inventory_batches")
}

model LocationStock {
  id        String         @id @default(cuid())
  location  String // "CT_SCANNER", "MRI_SCANNER", "XRAY_ROOM", "PHARMACY", "GENERAL_STORE"
  itemId    String
  item      InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId   String
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  quantity  Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([location, itemId, batchId])
  @@index([location])
  @@index([itemId])
  @@index([batchId])
  @@map("location_stocks")
}

model StockTransaction {
  id                String          @id @default(cuid())
  transactionNumber String          @unique // e.g. "TXN-2026-0001"
  type              String // "PURCHASE_RECEIPT", "ISSUE_CLINICAL", "TRANSFER", "WASTAGE", "ADJUSTMENT_DAMAGE", "ADJUSTMENT_RETURN", "ADJUSTMENT_CORRECTION", "AUDIT_RECONCILIATION", "FILM_PRINT", "FILM_SPOIL"
  itemId            String
  item              InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  sourceLocation    String? // null on purchase receipt
  targetLocation    String? // null on usage/consumption/wastage
  quantity          Int // moved quantity
  balanceBefore     Int
  balanceAfter      Int
  orderId           String? // linked ImagingOrder ID
  patientId         String? // linked Patient ID
  unitCost          Decimal?        @db.Decimal(10, 2)
  totalValue        Decimal?        @db.Decimal(10, 2)
  reference         String? // PO, invoice, accession, or credit note
  reason            String?
  performedById     String
  performedByName   String?
  createdAt         DateTime        @default(now())

  maintenanceUsages MaintenancePartUsage[]

  @@index([itemId])
  @@index([batchId])
  @@index([orderId])
  @@index([patientId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_transactions")
}

model WastageLog {
  id             String          @id @default(cuid())
  wastageNumber  String          @unique // e.g. "WST-2026-0001"
  itemId         String
  item           InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  location       String // e.g. "CT_SCANNER", "MRI_SCANNER"
  quantity       Int             @default(1) // vials or units
  volumeUsedMl   Decimal?        @db.Decimal(8, 2)
  volumeWastedMl Decimal?        @db.Decimal(8, 2)
  reason         String // "PARTIAL_VIAL_REMAINDER", "CONTAMINATION", "EXPIRED", "SPILLAGE"
  orderId        String?
  patientId      String?
  recordedById   String
  recordedByName String?
  recordedAt     DateTime        @default(now())

  @@index([itemId])
  @@index([batchId])
  @@index([orderId])
  @@map("wastage_logs")
}

model OrderConsumableUsage {
  id             String          @id @default(cuid())
  orderId        String // Accession / order linkage
  patientId      String // Patient linkage
  itemId         String
  item           InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId        String?
  batch          InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quantity       Int             @default(1)
  location       String
  recordedById   String
  recordedByName String?
  notes          String?
  recordedAt     DateTime        @default(now())

  @@index([orderId])
  @@index([patientId])
  @@index([itemId])
  @@map("order_consumable_usages")
}

model EmergencyChecklist {
  id              String                   @id @default(cuid())
  checklistNumber String                   @unique // e.g. "CHK-2026-0001"
  location        String // e.g. "CT_SCANNER", "MRI_SCANNER", "CRASH_CART"
  status          String                   @default("COMPLETED") // "COMPLETED", "ACTION_REQUIRED"
  checkedById     String
  checkedByName   String
  checkedAt       DateTime                 @default(now())
  notes           String?
  items           EmergencyChecklistItem[]

  @@index([location])
  @@index([checkedAt])
  @@map("emergency_checklists")
}

model EmergencyChecklistItem {
  id               String             @id @default(cuid())
  checklistId      String
  checklist        EmergencyChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  itemId           String
  item             InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId          String?
  status           String // "ACCEPTABLE", "EXPIRED", "LOW_STOCK", "REPLACED", "MISSING"
  currentStock     Int
  expiryDate       DateTime?
  replacementDone  Boolean            @default(false)
  replacementBatch String?
  remarks          String?

  @@index([checklistId])
  @@index([itemId])
  @@map("emergency_checklist_items")
}

model StockAudit {
  id            String           @id @default(cuid())
  auditNumber   String           @unique // e.g. "AUD-2026-0001"
  location      String
  status        String           @default("COMPLETED") // "IN_PROGRESS", "COMPLETED", "RECONCILED"
  auditedById   String
  auditedByName String
  auditedAt     DateTime         @default(now())
  totalVariance Int              @default(0)
  notes         String?
  items         StockAuditItem[]

  @@index([location])
  @@index([auditedAt])
  @@map("stock_audits")
}

model StockAuditItem {
  id                String          @id @default(cuid())
  auditId           String
  audit             StockAudit      @relation(fields: [auditId], references: [id], onDelete: Cascade)
  itemId            String
  item              InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             InventoryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  expectedQty       Int
  countedQty        Int
  variance          Int // countedQty - expectedQty
  discrepancyReason String?
  reconciled        Boolean         @default(false)

  @@index([auditId])
  @@index([itemId])
  @@map("stock_audit_items")
}

model SupplierPurchase {
  id            String    @id @default(cuid())
  poNumber      String    @unique // e.g. "PO-2026-0001"
  supplierName  String
  invoiceNumber String?
  invoiceDate   DateTime?
  totalAmount   Decimal   @default(0.00) @db.Decimal(10, 2)
  status        String    @default("RECEIVED")
  receivedById  String
  receivedAt    DateTime  @default(now())

  @@index([supplierName])
  @@index([receivedAt])
  @@map("supplier_purchases")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "USER_LOGIN", "PATIENT_CREATED", "ORDER_CREATED", "APPOINTMENT_SCHEDULED", "PATIENT_CHECKED_IN"
  entityType String // e.g. "User", "Patient", "ImagingOrder", "Appointment", "Study"
  entityId   String
  details    Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model ReportingTemplate {
  id          String       @id @default(cuid())
