}

model ReportDraft {
  id              String             @id @default(cuid())
  imagingOrderId  String             @unique
  imagingOrder    ImagingOrder       @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  authorId        String
  author          User               @relation("ReportDraftAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  templateId      String?
  template        ReportingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
