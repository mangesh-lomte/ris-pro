  acknowledgmentNotes String?               @db.Text
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([imagingOrderId])
  @@index([recipientId])
  @@index([createdById])
  @@index([status])
  @@map("critical_findings")
}

model ReportAmendment {
  id              String              @id @default(cuid())
  reportId        String
