}

// ============================================================================
// MODULE 12: EQUIPMENT MAINTENANCE & PREVENTIVE MAINTENANCE MODELS
// ============================================================================

model MaintenanceSchedule {
  id                  String               @id @default(cuid())
  scheduleNumber      String               @unique // e.g. "PM-2026-0001"
  equipmentId         String
  equipment           Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title               String // e.g. "Quarterly Gantry, RF Coil & Chiller PM"
  maintenanceType     String               @default("PREVENTIVE_MAINTENANCE") // "PREVENTIVE_MAINTENANCE", "CALIBRATION", "SAFETY_INSPECTION", "ELECTRICAL_SAFETY"
  frequency           String               @default("QUARTERLY") // "DAILY", "WEEKLY", "MONTHLY", "QUARTERLY", "BIANNUAL", "ANNUAL"
  intervalDays        Int                  @default(90)
  contractType        String?              @default("AMC") // "AMC", "CMC", "WARRANTY", "IN_HOUSE"
  contractId          String?
  contract            MaintenanceContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  lastCompletedDate   DateTime?
  scheduledDate       DateTime
  nextDueDate         DateTime
  assignedEngineer    String?
  vendorName          String?
  status              String               @default("SCHEDULED") // "SCHEDULED", "DUE", "OVERDUE", "IN_PROGRESS", "COMPLETED", "CANCELLED"
  notes               String?              @db.Text
  checklistTemplateId String?
  checklistTemplate   PmChecklistTemplate? @relation(fields: [checklistTemplateId], references: [id], onDelete: SetNull)
  completedChecklist  Json?
  completedById       String?
  completedByName     String?
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  serviceRecords ServiceRecord[]
  partsUsages    MaintenancePartUsage[]

  @@index([equipmentId])
  @@index([scheduledDate])
  @@index([nextDueDate])
  @@index([status])
  @@map("maintenance_schedules")
}

model PmChecklistTemplate {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. "PM-TMPL-CT-Q", "PM-TMPL-MRI-M"
  title           String
  modality        String // "CT", "MRI", "XRAY", "INJECTOR", "CHILLER", "UPS", "ALL"
  frequency       String // "MONTHLY", "QUARTERLY", "ANNUAL"
  oemManufacturer String? // "GE Healthcare", "Siemens Healthineers", "Universal OEM Standard"
  version         String   @default("1.0")
  sections        Json // Array of checklist sections with tests, tolerances and inspection steps
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  schedules MaintenanceSchedule[]

  @@index([modality])
  @@index([frequency])
  @@map("pm_checklist_templates")
}

model EquipmentQcCheck {
  id                 String    @id @default(cuid())
  checkNumber        String    @unique // e.g. "QC-2026-0001"
  equipmentId        String
  equipment          Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  frequency          String    @default("DAILY") // "DAILY", "WEEKLY"
  checkDate          DateTime  @default(now())
  performedById      String
  performedByName    String
  performedByRole    String    @default("TECHNOLOGIST") // "TECHNOLOGIST", "ENGINEER", "ADMIN"
  overallResult      String    @default("PASS") // "PASS", "FAIL", "WARNING"
  temperatureC       Decimal?  @db.Decimal(5, 2)
  humidityPercent    Decimal?  @db.Decimal(5, 2)
  chillerTempC       Decimal?  @db.Decimal(5, 2)
  heliumLevelPercent Decimal?  @db.Decimal(5, 2)
  ctNumberWaterHu    Decimal?  @db.Decimal(6, 2)
  noiseVariance      Decimal?  @db.Decimal(6, 3)
  checklistData      Json // Items array: { item, expected, actual, status, remarks }
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())

  @@index([equipmentId])
  @@index([checkDate])
  @@index([overallResult])
  @@map("equipment_qc_checks")
}

model ServiceTicket {
  id               String    @id @default(cuid())
  ticketNumber     String    @unique // e.g. "TKT-2026-0001"
  equipmentId      String
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  title            String
  description      String    @db.Text
  errorCodes       String?
  priority         String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "CRITICAL"
  status           String    @default("OPEN") // "OPEN", "ASSIGNED", "IN_PROGRESS", "AWAITING_PARTS", "RESOLVED", "CLOSED"
  reportedById     String
  reportedByName   String
  assignedEngineer String?
  vendorName       String?
  isDowntimeCaused Boolean   @default(false)
  downtimeId       String?
  openedAt         DateTime  @default(now())
  assignedAt       DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  resolutionNotes  String?   @db.Text
  rootCause        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  downtimes      EquipmentDowntime[]
  partsUsages    MaintenancePartUsage[]
  serviceRecords ServiceRecord[]

  @@index([equipmentId])
  @@index([status])
  @@index([priority])
  @@index([openedAt])
  @@map("service_tickets")
}

model EquipmentDowntime {
  id                        String         @id @default(cuid())
  downtimeNumber            String         @unique // e.g. "DWN-2026-0001"
  equipmentId               String
  equipment                 Equipment      @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  serviceTicketId           String?
  serviceTicket             ServiceTicket? @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  startTime                 DateTime
  endTime                   DateTime?
  durationMinutes           Int?
  causeCategory             String         @default("HARDWARE_FAILURE") // "HARDWARE_FAILURE", "SOFTWARE_CRASH", "SCHEDULED_PM", "POWER_OUTAGE", "CHILLER_FAULT", "TUBE_OVERHEAT"
  cause                     String         @db.Text
  impactLevel               String         @default("FULL_STOP") // "FULL_STOP", "PARTIAL_DEGRADATION", "NO_CLINICAL_IMPACT"
  affectedAppointmentsCount Int            @default(0)
  affectedAppointmentIds    Json?
  rescheduledCount          Int            @default(0)
  resolutionSummary         String?        @db.Text
  recordedById              String
  recordedByName            String
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  @@index([equipmentId])
  @@index([startTime])
  @@index([causeCategory])
  @@map("equipment_downtimes")
}

model MaintenancePartUsage {
  id                 String               @id @default(cuid())
  equipmentId        String
  equipment          Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  serviceTicketId    String?
  serviceTicket      ServiceTicket?       @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  pmScheduleId       String?
  pmSchedule         MaintenanceSchedule? @relation(fields: [pmScheduleId], references: [id], onDelete: SetNull)
  inventoryItemId    String
  inventoryItem      InventoryItem        @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  batchId            String?
  batch              InventoryBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  stockTransactionId String?
  stockTransaction   StockTransaction?    @relation(fields: [stockTransactionId], references: [id], onDelete: SetNull)
  location           String               @default("GENERAL_STORE")
  quantityUsed       Int                  @default(1)
  unitCost           Decimal              @default(0.00) @db.Decimal(10, 2)
  totalCost          Decimal              @default(0.00) @db.Decimal(10, 2)
  reason             String
  installedById      String
  installedByName    String
  installedAt        DateTime             @default(now())

  @@index([equipmentId])
  @@index([inventoryItemId])
  @@index([serviceTicketId])
  @@index([pmScheduleId])
  @@map("maintenance_part_usages")
}

model ServiceRecord {
  id                         String               @id @default(cuid())
  recordNumber               String               @unique // e.g. "SRV-2026-0001"
  equipmentId                String
  equipment                  Equipment            @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  serviceType                String               @default("PREVENTIVE_MAINTENANCE") // "PREVENTIVE_MAINTENANCE", "BREAKDOWN_REPAIR", "CALIBRATION", "PARTS_REPLACEMENT"
  serviceDate                DateTime
  serviceProvider            String
  engineerName               String
  engineerContact            String?
  workDescription            String               @db.Text
  partsReplaced              String?
  findingsAndRecommendations String?              @db.Text
  statusBefore               EquipmentStatus      @default(OUT_OF_SERVICE)
  statusAfter                EquipmentStatus      @default(AVAILABLE)
  customerSignOffBy          String?
  serviceReportUrl           String?
  cost                       Decimal?             @db.Decimal(10, 2)
  serviceTicketId            String?
  serviceTicket              ServiceTicket?       @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  pmScheduleId               String?
  pmSchedule                 MaintenanceSchedule? @relation(fields: [pmScheduleId], references: [id], onDelete: SetNull)
  createdAt                  DateTime             @default(now())

  @@index([equipmentId])
  @@index([serviceDate])
  @@index([serviceType])
  @@map("service_records")
}

model CalibrationCertificate {
  id                String    @id @default(cuid())
  certificateNumber String    @unique // e.g. "CAL-2026-0001"
  equipmentId       String
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  certificationType String // "RADIATION_SAFETY_AERB", "DOSIMETRY_CALIBRATION", "ELECTRICAL_SAFETY", "QA_PHANTOM_ALIGNMENT"
  issuingAuthority  String
  issueDate         DateTime
  expiryDate        DateTime // next due date
  status            String    @default("VALID") // "VALID", "EXPIRING_SOON", "EXPIRED"
  documentReference String?
  measuredValues    Json?
  passed            Boolean   @default(true)
  certifiedByName   String
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([equipmentId])
  @@index([expiryDate])
  @@index([status])
  @@map("calibration_certificates")
}

model MaintenanceContract {
  id                String    @id @default(cuid())
  contractNumber    String    @unique // e.g. "AMC-2026-0001"
  equipmentId       String
  equipment         Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  contractType      String    @default("AMC_COMPREHENSIVE") // "WARRANTY", "AMC_COMPREHENSIVE", "CMC", "ON_DEMAND"
  vendorName        String
  vendorContact     String?
  startDate         DateTime
  endDate           DateTime
  coverageDetails   String    @db.Text
  annualCost        Decimal?  @db.Decimal(10, 2)
  responseSlaHours  Int       @default(4)
  status            String    @default("ACTIVE") // "ACTIVE", "EXPIRING_SOON", "EXPIRED"
  contactPerson     String?
  escalationContact String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  schedules MaintenanceSchedule[]

  @@index([equipmentId])
  @@index([endDate])
  @@index([status])
  @@map("maintenance_contracts")
}

model ServiceContact {
  id                 String   @id @default(cuid())
  vendorName         String
  contactName        String
  role               String // "Field Engineer", "Service Manager", "OEM Technical Support"
  email              String
  phone              String
  emergencyPhone     String?
  escalationLevel    Int      @default(1) // 1=Field, 2=Regional, 3=Executive
  equipmentSpecialty String?
  vendorAddress      String?
  equipmentIds       Json? // array of supported equipment IDs
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([vendorName])
  @@index([role])
  @@map("service_contacts")
}

// ============================================================================
// MODULE 13: EXTERNAL SCAN / DICOM & REPORT SHARING
// ============================================================================

model ExternalShare {
  id               String       @id @default(cuid())
  shareNumber      String       @unique // e.g. "SHR-2026-0001"
  shareToken       String       @unique // Cryptographically secure 64-char hex string
  orderId          String
  order            ImagingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  reportId         String?
  report           Report?      @relation(fields: [reportId], references: [id], onDelete: SetNull)
  pacsStudyLinkId  String?
  studyInstanceUid String?
  accessionNumber  String
  patientMrn       String
  shareType        String       @default("PATIENT_LINK") // "PATIENT_LINK", "DOCTOR_SHARE", "OUTSIDE_HOSPITAL"
  recipientName    String
  recipientEmail   String?
  recipientPhone   String?
  recipientRole    String       @default("PATIENT") // "PATIENT", "REFERRING_PHYSICIAN", "OUTSIDE_HOSPITAL", "SPECIALIST"
  institutionName  String?
  includeDicom     Boolean      @default(true)
  includeReportPdf Boolean      @default(true)
  includeWebViewer Boolean      @default(true)
  requiresOtp      Boolean      @default(true)
  otpCode          String? // 6-digit verification code (honest local adapter)
  otpExpiresAt     DateTime?
  otpVerified      Boolean      @default(false)
  expiresAt        DateTime
  status           String       @default("ACTIVE") // "ACTIVE", "REVOKED", "EXPIRED", "ACCESSED"
  revokedAt        DateTime?
  revokedById      String?
  revokeReason     String?
  viewCount        Int          @default(0)
  lastAccessedAt   DateTime?
  createdById      String
  createdByUser    User         @relation("ExternalShareCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  consent    ShareConsent?
  transfers  LargeFileTransfer[]
  accessLogs ShareAccessLog[]

  @@index([orderId])
  @@index([patientId])
  @@index([shareToken])
  @@index([status])
  @@index([expiresAt])
  @@map("external_shares")
}

model ShareConsent {
  id                  String        @id @default(cuid())
  shareId             String        @unique
  share               ExternalShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  patientId           String
  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose             String // "SECOND_OPINION", "TRANSFER_OF_CARE", "PATIENT_PERSONAL_COPY", "REFERRAL_CONSULT", "LEGAL", "INSURANCE"
  consentedBy         String
  consentedByRelation String        @default("SELF") // "SELF", "PARENT", "LEGAL_GUARDIAN", "AUTHORIZED_REPRESENTATIVE"
  consentMethod       String        @default("DIGITAL_SIGNATURE") // "DIGITAL_SIGNATURE", "VERBAL_CONFIRMED", "SIGNED_FORM_ON_FILE"
  consentDate         DateTime      @default(now())
  validUntil          DateTime?
  notes               String?       @db.Text
  status              String        @default("ACTIVE") // "ACTIVE", "REVOKED"
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([patientId])
  @@map("share_consents")
}

model LargeFileTransfer {
  id               String         @id @default(cuid())
  transferNumber   String         @unique // e.g. "TRF-2026-0001"
  shareId          String?
  share            ExternalShare? @relation(fields: [shareId], references: [id], onDelete: SetNull)
  orderId          String
  order            ImagingOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  studyInstanceUid String
  accessionNumber  String
  destination      String // e.g. "Outside Hospital PACS", "ZIP Download Package", "DICOMweb STOW-RS"
  packageType      String         @default("DICOM_ZIP") // "DICOM_ZIP", "RAW_DICOM", "DICOM_ISO", "PDF_REPORT_BUNDLE"
  totalFiles       Int            @default(1)
  totalBytes       BigInt?
  transferredBytes BigInt?
  status           String         @default("QUEUED") // "QUEUED", "IN_PROGRESS", "COMPLETED", "FAILED", "RETRYING"
  progressPercent  Int            @default(0)
  startedAt        DateTime?
  completedAt      DateTime?
  retryCount       Int            @default(0)
  maxRetries       Int            @default(3)
  errorMessage     String?
  downloadUrl      String?
  createdById      String?
  createdByUser    User?          @relation("TransferCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("large_file_transfers")
}

model OutsideStudyImport {
  id                  String        @id @default(cuid())
  importNumber        String        @unique // e.g. "IMP-2026-0001"
  sourceInstitution   String // e.g. "City General Hospital", "Apex Diagnostics"
  modality            ModalityType
  studyDate           DateTime?
  studyDescription    String?
  patientNameRaw      String
  patientIdRaw        String?
  patientDobRaw       DateTime?
  patientGenderRaw    String?
  accessionRaw        String?
  studyInstanceUid    String        @unique
  numberOfInstances   Int           @default(0)
  fileSize            BigInt?
  storagePath         String?
  status              String        @default("PENDING_VERIFICATION") // "PENDING_VERIFICATION", "MATCHED", "RECONCILED", "REJECTED"
  matchedPatientId    String?
  matchedPatient      Patient?      @relation(fields: [matchedPatientId], references: [id], onDelete: SetNull)
  matchedOrderId      String?
  matchedOrder        ImagingOrder? @relation(fields: [matchedOrderId], references: [id], onDelete: SetNull)
  reconciliationNotes String?       @db.Text
  reconciledById      String?
  reconciledByUser    User?         @relation("ImportReconciledBy", fields: [reconciledById], references: [id])
  reconciledAt        DateTime?
  importedById        String
  importedByUser      User          @relation("OutsideImportCreatedBy", fields: [importedById], references: [id])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([studyInstanceUid])
  @@index([status])
  @@index([matchedPatientId])
  @@map("outside_study_imports")
}

model ShareAccessLog {
  id            String        @id @default(cuid())
  shareId       String
  share         ExternalShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  action        String // "SHARE_OPENED", "OTP_REQUESTED", "OTP_VERIFIED", "REPORT_VIEWED", "IMAGES_VIEWED", "DICOM_DOWNLOADED", "PDF_DOWNLOADED"
  ipAddress     String?
  userAgent     String?
  success       Boolean       @default(true)
  failureReason String?
  createdAt     DateTime      @default(now())

  @@index([shareId])
  @@map("share_access_logs")
}

// ============================================================================
// MODULE 14: ADMINISTRATION, SAFETY & REPORTS MODELS
// ============================================================================

model PatientMergeRecord {
  id               String   @id @default(cuid())
  sourcePatientId  String
  sourceMrn        String
  targetPatientId  String
  targetMrn        String
  reason           String   @db.Text
  reassignedCounts Json
  performedById    String
  performedByName  String
  createdAt        DateTime @default(now())

  @@index([sourceMrn])
  @@index([targetMrn])
  @@map("patient_merge_records")
}

model DataRetentionRule {
  id             String   @id @default(cuid())
  dataCategory   String   @unique // e.g. "DIAGNOSTIC_IMAGES_PACS", "FINAL_REPORTS", "PATIENT_DEMOGRAPHICS", "AUDIT_LOGS", "BILLING_INVOICES"
  policyName     String
  retentionYears Int
  description    String?  @db.Text
  legalBasis     String?
  actionOnExpiry String   @default("REVIEW_REQUIRED")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("data_retention_rules")
}

model BackupRecord {
  id                  String    @id @default(cuid())
  backupType          String    // "AUTOMATED_DAILY", "MANUAL_ADMIN", "PRE_UPGRADE"
  status              String    // "IN_PROGRESS", "COMPLETED", "FAILED", "VERIFIED"
  filename            String
  filePath            String?
  sizeBytes           BigInt?
  checksumSha256      String?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  verifiedAt          DateTime?
  verificationDetails Json?
  errorMessage        String?   @db.Text
  triggeredById       String?
  triggeredByName     String?

  @@index([status])
  @@index([startedAt])
  @@map("backup_records")
}

model DisasterRecoveryDrill {
  id              String   @id @default(cuid())
  drillName       String
  drillType       String
  status          String   // "PASSED", "WARNING", "FAILED"
  executedAt      DateTime @default(now())
  durationSec     Int
  backupRecordId  String?
  recoveryTarget  String
  findings        String   @db.Text
  signedOffById   String
  signedOffByName String

  @@index([executedAt])
  @@map("disaster_recovery_drills")
}

model OrderDocument {
  id               String           @id @default(cuid())
  imagingOrderId   String
  imagingOrder     ImagingOrder     @relation(fields: [imagingOrderId], references: [id], onDelete: Cascade)
  patientId        String
  patient          Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  accessionNumber  String
  category         DocumentCategory @default(OTHER)
  fileName         String
  storedFilename   String
  fileType         String
  fileSize         Int
  notes            String?          @db.Text
  uploadedByUserId String?
  uploadedByUser   User?            @relation("DocumentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedAt       DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([imagingOrderId])
  @@index([patientId])
  @@index([accessionNumber])
  @@index([category])
  @@map("order_documents")
}
